# 这些变量会在 Next.js build 时写入浏览器包；修改后必须重启 dev 或重新 build。
# 浏览器侧 baseURL 必须用 localhost：若用 127.0.0.1 则与页面（http://localhost:3000）跨 site，
# 后端 SameSite=Lax 的登录 cookie 不会随请求发送，导致登录循环。
# 注意：next.config.js 的 rewrite 代理目标已硬编码 127.0.0.1（Node 侧），不受此值影响。
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_YWS_URL=ws://localhost:1234

# 可选：Node 侧（SSR/route handler）直连后端的 baseURL，默认 127.0.0.1:3001。
# 本地无需配置；远程部署（后端不在本机）时设为线上后端地址。
# SERVER_API_URL=http://127.0.0.1:3001/api
