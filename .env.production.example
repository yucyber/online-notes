# 复制为 .env.production，权限设为 600；不要提交真实 Key。
PUBLIC_HOST=47.97.243.59
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/notes?retryWrites=true&w=majority
JWT_SECRET=CHANGE_ME_GENERATE_64_HEX_CHARACTERS
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=CHANGE_ME_GENERATE_32_HEX_CHARACTERS

# MAIL_FROM 在真实环境填写：在线笔记验证码 <你的QQ邮箱>
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Key 留空不阻塞启动；填入后执行部署脚本，重建容器后生效。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_ECONOMY_TEXT_MODEL=Qwen/Qwen3.5-4B
SILICONFLOW_STANDARD_TEXT_MODEL=Qwen/Qwen3-14B
SILICONFLOW_DEEP_REASONING_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
SILICONFLOW_RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
SILICONFLOW_RERANKER_PATH=/rerank
SILICONFLOW_AI_MAX_CONCURRENCY=2
SILICONFLOW_AI_RPM=30
SILICONFLOW_AI_TPM=40000
BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai/v1
BAI_FALLBACK_MODEL=deepseek-v4-flash
BAI_AI_MAX_CONCURRENCY=1
BAI_AI_RPM=10
BAI_AI_TPM=30000
AR_API_KEY=
AR_BASE_URL=https://ps.air-outer.com/v1
AR_MODEL=claude-opus-4-8
AR_AI_MAX_CONCURRENCY=1
AR_AI_RPM=5
AR_AI_TPM=20000
AI_TASK_ROUTING_ENABLED=true
AI_TEXT_PROVIDER=siliconflow
AI_REASONING_PROVIDER=siliconflow
AI_EMBEDDING_PROVIDER=siliconflow
AI_RERANKER_PROVIDER=siliconflow
NOTE_DERIVED_QUIET_MS=10000
AI_CAPACITY_KEY_PREFIX=ai:capacity
