{
  "name": "notes-backend",
  "version": "1.0.0",
  "description": "在线知识笔记平台后端API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "nodemon",
    "start:prod": "node dist/main.js",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "evaluate:ai-routes": "node -r ts-node/register scripts/evaluate-ai-routes.ts",
    "cleanup:pre-july-2026": "node -r ts-node/register -r ./scripts/set-dns.ts scripts/cleanup-pre-july-2026.ts",
    "backfill:note-vectors": "node -r ts-node/register -r ./scripts/set-dns.ts scripts/backfill-note-vectors.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.2",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-ws": "^10.4.20",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ioredis": "^5.8.2",
    "ml-kmeans": "^7.0.0",
    "mongoose": "^8.0.4",
    "parse5": "^7.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "rate-limiter-flexible": "^9.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "overrides": {
    "qs": "6.14.1",
    "path-to-regexp": "^0.1.12",
    "path-to-regexp@>=6.0.0 <6.3.0": "^6.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^3.0.13",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "nestjs",
    "api",
    "notes",
    "mongodb"
  ],
  "author": "在线知识笔记平台团队",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  }
}
